<%- include('partials/header') %>

<!--Section 0: INtroduction-->

<section class="intro">

    <h1>
        Project: Dip Transform for 3D Shape Reconstruction
    </h1>
    <p>
        Run the dip simulator and use the output to run the dip reconstruction, or build your own dip machine
        and upload the raw dip data directly into the dip reconstruction.
    </p>

</section>

<!--Section 1: Dip Simulator-->

<section class="card">
    <h2>Virtual Dip Simulator</h2>
<!--Left Column: Dip simulator input-->
    <div class="workspace">
        <form id="simulateForm" action = "/simulate" method="POST" enctype="multipart/form-data">

        <label for="shape">Default Shape</label>
        <select name="shape" id="shape">
            <option value="sphere">Sphere</option>
            <option value="cube">Cube</option>
            <option value="icosahedron">Icosahedron</option>
        </select>
        <p>OR</p>
        <label for="obj">Upload custom mesh (.obj)</label>
        <input type="file" id="obj" name="obj" accept=".obj">
        <label for="dips">Number of dips</label>
        <input type="number" id="dips" name="dips" value="400" min="1" max="5000">
        <label for="noise">Noise strength (%)</label>
        <input type="number" id="noise" name="noise" value="0" min="0" max="100">

        <button type="submit">Run Simulation</button>

    </form>

    <!--Right Column: Dip simulator status, visualization (changing with status), output for download-->
        <div class="results">
            <div id="simViewer" class="mesh-viewer"></div>
            <p id="sim-stage"></p>
            <progress id="sim-progress" value="0"></progress>


            <pre id="sim-logs"></pre>
            <div id ="sim-output"></div>
        </div>

    </div>
</section>



<!--Section 2: Dip Reconstructor-->

<section class="card">
    <h2>3D Shape Reconstruction</h2>
    <div class="workspace">
        <!--Left Column: Dip simulator input-->

        <form id="reconstructForm" action = "/reconstruct" method="POST" enctype="multipart/form-data">

        <label for="csv">Upload dipping measurements(.csv)</label>
        <input type="file" id="csv" name="csv" accept=".csv">
        <p class="hint">OR leave empty to use the latest simulation ouput</p>
        <input type="hidden" name="sourceJob" id="sourceJob">

        <button type="submit">Run Reconstruction</button>
        </form>
        
        <!--Right Column: Dip simulator status, visualization (changing with status), output for download-->
        <div class="results">
            <div id="recViewer" class="mesh-viewer"></div>
            <p id="rec-stage"></p>
            <progress id="rec-progress" value="0"></progress>

            <pre id="rec-logs"></pre>
            <div id="rec-ouput"></div>
        </div>
        
    </div>

</section>



<script type="module">
import * as THREE from 'three';
import { OBJLoader } from 'three/addons/loaders/OBJLoader.js';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

function createViewer(elementId) {

    const container = document.getElementById(elementId);

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0xedf2f7);
    const camera = new THREE.PerspectiveCamera(
        45,
        container.clientWidth / container.clientHeight,
        0.1,
        10000
    );

    const renderer = new THREE.WebGLRenderer({
        antialias: true
    });

    renderer.setSize(
        container.clientWidth,
        container.clientHeight
    );

    container.appendChild(renderer.domElement);

    scene.add(new THREE.AmbientLight(0xffffff, 2));

    const light = new THREE.DirectionalLight(0xffffff, 2);
    light.position.set(5, 10, 8);
    scene.add(light);

    const controls = new OrbitControls(
        camera,
        renderer.domElement
    );

    controls.enableDamping = true;

    let currentObject = null;

    function displayObject(object) {

        // Remove previous mesh
        if (currentObject) {
            scene.remove(currentObject);
        }

        currentObject = object;

        object.traverse(child => {
            if (child.isMesh) {
                child.material = new THREE.MeshStandardMaterial({
                    color: 0x347daf,
                    side: THREE.DoubleSide
                });
            }
        });

        scene.add(object);

        // Automatically frame the mesh
        const box = new THREE.Box3().setFromObject(object);
        const center = box.getCenter(new THREE.Vector3());
        const size = box.getSize(new THREE.Vector3()).length();

        controls.target.copy(center);

        camera.position.copy(center).add(
            new THREE.Vector3(size, size * 0.7, size)
        );

        camera.near = Math.max(0.001, size / 1000);
        camera.far = Math.max(100, size * 100);
        camera.updateProjectionMatrix();

        controls.update();
    }

    const loader = new OBJLoader();

    function load(url) {
        loader.load(url, displayObject,
            undefined, error => console.error(error));
    }

    function animate() {
        requestAnimationFrame(animate);
        controls.update();
        renderer.render(scene, camera);
    }

    animate();

    return { load, displayObject };
}

const simulatorViewer = createViewer('simViewer');
const reconstructionViewer = createViewer('recViewer');

// Expose functions to your normal homepage JavaScript
window.showInput = url => simulatorViewer.load(url);
window.showMesh = url => reconstructionViewer.load(url);
</script>

<script>
let latestSimulation = null;

async function startJob(formId, url, prefix) {
    const form = document.getElementById(formId);
    const data = new FormData(form);

    // Uploaded CSV takes precedence over previous simulation
    if (prefix === 'rec' && data.get('csv').size > 0) {
        data.delete('sourceJob');
    }

    const response = await fetch(url, {
        method: 'POST',
        body: data
    });

    const result = await response.json();

    if (!response.ok) {
        throw new Error(result.error);
    }

    const id = result.jobId;

    document.getElementById(`${prefix}-output`).innerHTML = '';
    document.getElementById(`${prefix}-logs`).textContent = '';

    // Check Python job status every second
    const timer = setInterval(async () => {

        const response = await fetch(`/job/${id}`);
        const job = await response.json();

        document.getElementById(`${prefix}-stage`).textContent =
            job.stage;

        document.getElementById(`${prefix}-progress`).value =
            job.progress;

        document.getElementById(`${prefix}-logs`).textContent =
            job.logs.join('\n');


        if (job.status === 'completed') {
            clearInterval(timer);

            if (prefix === 'sim') {
                latestSimulation = id;

                document.getElementById('sourceJob').value = id;

                // Show the original object
                showInput(`/data/${id}/input.obj`);

                // CSV download
                document.getElementById('sim-output').innerHTML =
                    `<a href="/data/${id}/dip_data.csv" download>
                        Download Dipping Data (.csv)
                    </a>`;
            }

            if (prefix === 'rec') {

                // Show reconstructed mesh
                showMesh(`/data/${id}/dip_reconstruction.obj`);

                // OBJ download
                document.getElementById('rec-output').innerHTML =
                    `<a href="/data/${id}/dip_reconstruction.obj" download>
                        Download Reconstructed Mesh (.obj)
                    </a>`;
            }
        }


        if (job.status === 'failed') {
            clearInterval(timer);
        }

    }, 1000);
}

document.getElementById('simulateForm').onsubmit = async e => {
    e.preventDefault();

    try {
        await startJob('simulateForm', '/simulate', 'sim');
    } catch (error) {
        document.getElementById('sim-stage').textContent = error.message;
    }
};

document.getElementById('reconstructForm').onsubmit = async e => {
    e.preventDefault();

    if (!latestSimulation &&
        !document.querySelector('[name="csv"]').files.length) {
        alert('Upload a CSV or complete a simulation first.');
        return;
    }

    try {
        await startJob('reconstructForm', '/reconstruct', 'rec');
    } catch (error) {
        document.getElementById('rec-stage').textContent = error.message;
    }
};

document.getElementById('obj').addEventListener('change', e => {
    const file = e.target.files[0];
    if (!file) return;

    const url = URL.createObjectURL(file);

    simulatorViewer.load(url);
});
</script>


<%- include('partials/footer') %>