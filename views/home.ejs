<%- include('partials/header') %>

<!--Section 0: INtroduction-->

<section class="intro">

    <h1>
        Dip Transform for 3D Shape Reconstruction
    </h1>
    <p>
        Run the dip simulator and use the output to run the dip reconstruction, or build your own dip machine
        and upload the raw dip data directly into the dip reconstruction.
    </p>

</section>

<!--Section 1: Dip Simulator-->

<section class="card">
<!--Left Column: Dip simulator input-->
    <div class="workspace">
        <form id="simulateForm" action = "/simulate" method="POST" enctype="multipart/form-data">
        <h2>Virtual Dip Simulator</h2>

        <label for="shape">Default Shape</label>
        <select name="shape" id="shape">
            <option value="sphere">Sphere</option>
            <option value="cube">Cube</option>
            <option value="icosahedron">Icosahedron</option>
        </select>
        <p>OR</p>
        <label for="obj">Upload custom mesh (.obj)</label>
        <input type="file" id="obj" name="obj" accept=".obj">
        <label for="dips">Number of dips</label>
        <input type="number" id="dips" name="dips" value="100" min="1" max="5000">
        <label for="noise">Add ripples (noise %)</label>
        <input type="number" id="noise" name="noise" value="0" min="0" max="100">

        <button type="submit">Run Simulation</button>

    </form>

    <!--Right Column: Dip simulator status, visualization (changing with status), output for download-->
        <div class="results">
            <div id="simViewer" class="mesh-viewer"></div>
            <pre id="sim-logs" class="terminal"></pre>
            <div id ="sim-output" class="downloads"></div>
        </div>

    </div>
</section>



<!--Section 2: Dip Reconstructor-->

<section class="card">
    <div class="workspace">
        <!--Left Column: Dip simulator input-->

        <form id="reconstructForm" action = "/reconstruct" method="POST" enctype="multipart/form-data">
        <h2>3D Shape Reconstruction</h2>

        <label for="csv">Upload dipping measurements(.csv)</label>
        <input type="file" id="csv" name="csv" accept=".csv">
                <p>OR</p>

        <p class="hint">leave empty to use the latest simulation ouput</p>
        <input type="hidden" name="sourceJob" id="sourceJob">

        <button type="submit">Run Reconstruction</button>
        </form>
        
        <!--Right Column: Dip simulator status, visualization (changing with status), output for download-->
        <div class="results">
            <div id="recViewer" class="mesh-viewer"></div>
            <pre id="rec-logs" class="terminal"></pre>
            <div id="rec-output"  class="downloads"></div>
        </div>
        
    </div>

</section>


<script type="importmap">
{
    "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.160.1/build/three.module.js",
        "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.1/examples/jsm/"
    }
}
</script>

<script type="module">
import * as THREE from 'three';
import { OBJLoader } from 'three/addons/loaders/OBJLoader.js';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

let latestSimulation = null;

// -----------------------
// 1. Interactive OBJ viewer
// -----------------------
function createViewer(id) {
    const container = document.getElementById(id);

    const scene = new THREE.Scene();
    scene.background = new THREE.Color('#2c4972');

    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 10000);
    const renderer = new THREE.WebGLRenderer({ antialias: true });

    container.appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;

    scene.add(new THREE.HemisphereLight(0xffffff, 0x445566, 3));

    let currentObject;

    function resize() {
        const width = container.clientWidth;
        const height = container.clientHeight;

        renderer.setSize(width, height);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
    }

    window.addEventListener('resize', resize);
    resize();

    function load(url) {
        new OBJLoader().load(url, object => {

            if (currentObject) {
                scene.remove(currentObject);
                currentObject.traverse(child => {
                    if (child.isMesh) {
                        child.geometry.dispose();
                        child.material.dispose();
                    }
                });
            }

            currentObject = object;

            object.traverse(child => {
                if (child.isMesh) {
                    child.material = new THREE.MeshStandardMaterial({
                        color: 0x7d9aad,
                        side: THREE.DoubleSide
                    });
                }
            });

            scene.add(object);

            // Automatically position camera around the object
            const box = new THREE.Box3().setFromObject(object);
            const center = box.getCenter(new THREE.Vector3());
            const size = Math.max(
                ...box.getSize(new THREE.Vector3()).toArray()
            );

            controls.target.copy(center);
            camera.position.copy(center).add(
                new THREE.Vector3(size * 1.5, size, size * 1.5)
            );

            camera.near = Math.max(size / 1000, 0.001);
            camera.far = Math.max(size * 100, 100);
            camera.updateProjectionMatrix();
            controls.update();

        }, undefined, error => {
            console.error('.obj loading failed:', error);
            container.insertAdjacentHTML(
                'beforeend',
                '<p class="viewer-error">Unable to display .obj.</p>'
            );
        });
    }

    renderer.setAnimationLoop(() => {
        controls.update();
        renderer.render(scene, camera);
    });

    return { load };
}

const simViewer = createViewer('simViewer');
const recViewer = createViewer('recViewer');

// -----------------------
// 2. Preview uploaded OBJ
// -----------------------
let previewURL = null;

document.getElementById('obj').onchange = e => {
    const file = e.target.files[0];
    if (!file) return;

    if (previewURL) URL.revokeObjectURL(previewURL);
    previewURL = URL.createObjectURL(file);

    simViewer.load(previewURL);
};

// --------------
// 3. Run Python jobs
// -----------------------

// Display \r as a terminal-style overwrite of the current line
function terminalText(raw) {
    const lines = [''];

    for (const char of raw.split(/(r\|\n)/)) {
        if (char === '\r') {
            lines[lines.length - 1] = '';
        } else if (char === '\n') {
            lines.push('');
        } else {
            lines[lines.length - 1] += char;
        }
    }

    return lines.join('\n').trimEnd();
}

async function runJob(formId, url, prefix) {
    const data = new FormData(document.getElementById(formId));

    const response = await fetch(url, {
        method: 'POST',
        body: data
    });

    const result = await response.json();
    if (!response.ok) throw new Error(result.error);

    const id = result.jobId;

    const terminal = document.getElementById(`${prefix}-logs`);
    const output = document.getElementById(`${prefix}-output`);

    terminal.textContent = 'loading ...';
    output.innerHTML = '';

    const timer = setInterval(async () => {
        try {
            const res = await fetch(`/job/${id}`);
            if (!res.ok) throw new Error('Could not retrieve Python output');

            const job = await res.json();

            // Display live Python stdout/stderr
            if (job.output) {
                terminal.textContent = terminalText(job.output);
                terminal.scrollTop = terminal.scrollHeight;
            }


            if (job.status === 'running') return;

            clearInterval(timer);
            //leave output visible
            terminal.textContent = terminalText(job.output);

            if (job.status === 'failed') return;

            if (prefix === 'sim') {
                latestSimulation = id;
                document.getElementById('sourceJob').value = id;

                simViewer.load(`/data/${id}/input.obj`);

                output.innerHTML = `
                    <a href="/data/${id}/dip_data.csv" download>Download .csv</a>
                `;
            } else {
                recViewer.load(`/data/${id}/dip_reconstruction.obj`);

                output.innerHTML = `
                    <a href="/data/${id}/dip_reconstruction.obj" download>Download .obj</a>
                `;
            }
        } catch (error) {
            clearInterval(timer);
            terminal.textContent += `\nERROR: ${error.message}`;
        }
    }, 200);
}

// -----------------------
// 4. Form submissions
// -----------------------
document.getElementById('simulateForm').onsubmit = async e => {
    e.preventDefault();

    try {
        await runJob('simulateForm', '/simulate', 'sim');
    } catch (error) {
        document.getElementById('sim-logs').textContent = error.message;
    }
};

document.getElementById('reconstructForm').onsubmit = async e => {
    e.preventDefault();

    const csv = document.getElementById('csv').files[0];

    if (!csv && !latestSimulation) {
        alert('Upload a .csv or run a simulation first.');
        return;
    }

    try {
        await runJob('reconstructForm', '/reconstruct', 'rec');
    } catch (error) {
        document.getElementById('rec-logs').textContent = error.message;
    }
};
</script>

<%- include('partials/footer') %>